@page "/results"
@rendermode InteractiveServer
@inject ScanService Scan
@inject WebSettingsService WebSettings
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Results — Video Duplicate Finder</PageTitle>

<h1>Duplicate Groups</h1>

@{
    var allDuplicates = Scan.Duplicates;
    var filteredGroups = GetFilteredGroups();
    _currentPage = ResultGroupProjection.ClampPage(
        _currentPage, filteredGroups.Count, _pageSize);
    var pageGroups = ResultGroupProjection.GetPage(
        filteredGroups, _currentPage, _pageSize);
    int pageCount = ResultGroupProjection.GetPageCount(filteredGroups.Count, _pageSize);
    int firstVisibleGroup = filteredGroups.Count == 0 ? 0 : ((_currentPage - 1) * _pageSize) + 1;
    int lastVisibleGroup = Math.Min(_currentPage * _pageSize, filteredGroups.Count);
    long totalSize = filteredGroups.Sum(group => group.TotalSize);
    long potentialSavings = filteredGroups.Sum(group => group.PotentialSavings);
    int totalFiles = filteredGroups.Sum(group => group.FileCount);
    long selectedSize = _selected.Sum(i => Math.Max(0, i.SizeLong));
    int renderIndex = 0;
}

@if (!allDuplicates.Any()) {
    <p>No duplicates found. <a href="/">Run a scan</a> first.</p>
}
else {
    <div class="results-toolbar" @onkeydown="OnKeyDown" tabindex="0">
        <input class="search-box" value="@_search" @oninput="OnSearchInput"
               placeholder="Filter by path (* and ? wildcards)..." />
        @if (!string.IsNullOrEmpty(_search)) {
            <button @onclick="ClearSearch">&#x2715;</button>
        }
        <div class="result-filter-tabs" aria-label="Similarity filter">
            <button class="@(_similarityFilter == ResultSimilarityFilter.All ? "active" : "")"
                    @onclick="() => SetSimilarityFilter(ResultSimilarityFilter.All)">All</button>
            <button class="@(_similarityFilter == ResultSimilarityFilter.DisplayedHundredPercent ? "active" : "")"
                    @onclick="() => SetSimilarityFilter(ResultSimilarityFilter.DisplayedHundredPercent)">100.0%</button>
            <button class="@(_similarityFilter == ResultSimilarityFilter.BelowDisplayedHundredPercent ? "active" : "")"
                    @onclick="() => SetSimilarityFilter(ResultSimilarityFilter.BelowDisplayedHundredPercent)">Below 100.0%</button>
        </div>
        <label class="result-control">
            Group order
            <select value="@_groupSort" @onchange="OnGroupSortChanged">
                <option value="SimilarityDescending">Similarity high to low</option>
                <option value="SimilarityAscending">Similarity low to high</option>
            </select>
        </label>
        <label class="result-control">
            Per page
            <select value="@_pageSize" @onchange="OnPageSizeChanged">
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </label>
        <span class="result-count">
            @filteredGroups.Count group(s), @totalFiles file(s), @FormatSize(totalSize) — potential savings @FormatSize(potentialSavings)
            @if (_selected.Count > 0) { <text> — @_selected.Count selected (@FormatSize(selectedSize))</text> }
        </span>

        @if (_folderFilter != null) {
            <span class="folder-filter-chip" title="@_folderFilter">
                Folder: @_folderFilter
                <button @onclick="ClearFolderFilter" title="Clear folder filter">&#x2715;</button>
            </span>
        }
        @foreach (string directory in _excludedDirectories.OrderBy(path => path)) {
            <span class="folder-filter-chip excluded" title="@directory">
                Excluded: @directory
                <button @onclick="() => RemoveExcludedDirectory(directory)"
                        title="Remove directory exclusion">&#x2715;</button>
            </span>
        }
        @if (_excludedDirectories.Count > 1) {
            <button @onclick="ClearExcludedDirectories">Clear exclusions</button>
        }

        @* Auto-select dropdown *@
        <div class="dropdown-wrap">
            <button @onclick="() => _autoSelectOpen = !_autoSelectOpen"
                    title="Choose whether selection applies to this page or all filtered pages">Select &#x25BE;</button>
            @if (_autoSelectOpen) {
                <div class="dropdown-overlay" @onclick="() => _autoSelectOpen = false"></div>
                <div class="dropdown-menu">
                    <div class="dropdown-section-title">This page</div>
                    <button @onclick="() => AutoSelect(AutoSelectMode.LowestQuality, AutoSelectScope.CurrentPage)">Lowest quality</button>
                    <button @onclick="() => AutoSelect(AutoSelectMode.SmallestFile, AutoSelectScope.CurrentPage)">Smallest file</button>
                    <button @onclick="() => ApplyRule(ResultSelectionRule.KeepNewestCreated, AutoSelectScope.CurrentPage)">Keep newest created</button>
                    <button @onclick="() => ApplyRule(ResultSelectionRule.KeepOldestCreated, AutoSelectScope.CurrentPage)">Keep oldest created</button>
                    <button @onclick="() => ApplyRule(ResultSelectionRule.KeepNewestModified, AutoSelectScope.CurrentPage)">Keep newest modified</button>
                    <button @onclick="() => ApplyRule(ResultSelectionRule.KeepOldestModified, AutoSelectScope.CurrentPage)">Keep oldest modified</button>
                    <button @onclick="() => AutoSelect(AutoSelectMode.HundredPercentEqual, AutoSelectScope.CurrentPage)">100.0% groups</button>
                    <button @onclick="() => InvertSelection(AutoSelectScope.CurrentPage)">Invert page selection</button>
                    <hr />
                    <div class="dropdown-section-title">All filtered pages</div>
                    <button @onclick="() => AutoSelect(AutoSelectMode.LowestQuality, AutoSelectScope.AllFiltered)">Lowest quality</button>
                    <button @onclick="() => AutoSelect(AutoSelectMode.SmallestFile, AutoSelectScope.AllFiltered)">Smallest file</button>
                    <button @onclick="() => ApplyRule(ResultSelectionRule.KeepNewestCreated, AutoSelectScope.AllFiltered)">Keep newest created</button>
                    <button @onclick="() => ApplyRule(ResultSelectionRule.KeepOldestCreated, AutoSelectScope.AllFiltered)">Keep oldest created</button>
                    <button @onclick="() => ApplyRule(ResultSelectionRule.KeepNewestModified, AutoSelectScope.AllFiltered)">Keep newest modified</button>
                    <button @onclick="() => ApplyRule(ResultSelectionRule.KeepOldestModified, AutoSelectScope.AllFiltered)">Keep oldest modified</button>
                    <button @onclick="() => AutoSelect(AutoSelectMode.HundredPercentEqual, AutoSelectScope.AllFiltered)">100.0% groups</button>
                    <button @onclick="() => InvertSelection(AutoSelectScope.AllFiltered)">Invert filtered selection</button>
                    <hr />
                    <button @onclick="ClearSelection">Deselect all</button>
                </div>
            }
        </div>

        <button @onclick="() => _rulesOpen = !_rulesOpen" aria-expanded="@_rulesOpen">Rules (@Scan.ProtectedResultDirectories.Count protected folders)</button>

        @* Collapse all / Expand all *@
        <button @onclick="CollapseAll" title="Collapse all groups">Collapse all</button>
        <button @onclick="ExpandAll" title="Expand all groups">Expand all</button>
        <button @onclick="ExportCsv" title="Download the results list as CSV">Export CSV</button>

        @if (_selected.Count > 0) {
            <div class="action-group">
                <button @onclick="RemoveSelected">Remove from list</button>
                <button @onclick="() => _confirmDelete = true" class="danger-outline" disabled="@Scan.FileOpRunning">Delete (trash)</button>
                <button @onclick="() => _confirmDeletePermanent = true" class="danger" disabled="@Scan.FileOpRunning">Delete permanently</button>
                <button @onclick="() => _showMovePanel = !_showMovePanel" disabled="@Scan.FileOpRunning">Move to folder…</button>
                <button @onclick="() => _showLinkPanel = !_showLinkPanel" disabled="@Scan.FileOpRunning">Replace with links…</button>
                <button @onclick="ClearSelection">Deselect all</button>
            </div>
        }
    </div>

    @if (_rulesOpen) {
        <section class="result-rules-panel" aria-label="Selection rules">
            <h2>Selection rules</h2>
            <p>Checked files are marked for deletion. Protected folders include all subfolders and override every selection rule.</p>
            <div class="result-rules-controls">
                <label>Protected folder (absolute server path)
                    <input @bind="_protectedFolderInput" placeholder="Absolute folder path" />
                </label>
                <button @onclick="AddProtectedFolder" disabled="@Scan.FileOpRunning">Add folder</button>
            </div>
            <div class="result-rules-folders">
                @foreach (string directory in Scan.ProtectedResultDirectories.OrderBy(path => path)) {
                    <span class="folder-filter-chip" title="@directory">
                        Protected: @directory
                        <button @onclick="() => RemoveProtectedFolder(directory)" disabled="@Scan.FileOpRunning" title="Remove protection">&#x2715;</button>
                    </span>
                }
            </div>
            <div class="result-rules-controls">
                <label>Keep rule
                    <select @bind="_selectionRule">
                        <option value="KeepProtectedFolders">Keep all files in protected folders</option>
                        <option value="KeepNewestCreated">Keep newest creation date</option>
                        <option value="KeepOldestCreated">Keep oldest creation date</option>
                        <option value="KeepNewestModified">Keep newest modification date</option>
                        <option value="KeepOldestModified">Keep oldest modification date</option>
                    </select>
                </label>
                <label>Apply to
                    <select @bind="_ruleScope">
                        <option value="AllFiltered">All filtered pages</option>
                        <option value="CurrentPage">This page</option>
                    </select>
                </label>
                <button class="primary" @onclick="() => ApplyRule(_selectionRule, _ruleScope)"
                        disabled="@(Scan.FileOpRunning || (_selectionRule == ResultSelectionRule.KeepProtectedFolders && Scan.ProtectedResultDirectories.Count == 0))">Apply rule</button>
            </div>
            <p>Replaces selections in the chosen scope; selections outside that scope remain. Dates are compared within each complete duplicate group; tied dates are kept. Groups with missing dates are skipped (rescan to populate dates). The folder rule skips groups without a protected file. Use Delete after reviewing the selection.</p>
        </section>
    }

    <div class="results-pagination" aria-label="Results pages">
        <span>Showing groups @firstVisibleGroup–@lastVisibleGroup</span>
        <button @onclick="() => GoToPage(1)" disabled="@(_currentPage <= 1)">First</button>
        <button @onclick="() => GoToPage(_currentPage - 1)" disabled="@(_currentPage <= 1)">Previous</button>
        <strong>Page @_currentPage / @pageCount</strong>
        <button @onclick="() => GoToPage(_currentPage + 1)" disabled="@(_currentPage >= pageCount)">Next</button>
        <button @onclick="() => GoToPage(pageCount)" disabled="@(_currentPage >= pageCount)">Last</button>
    </div>

    @* Batch file operation progress *@
    @if (Scan.FileOpRunning) {
        <div class="action-panel">
            <span class="spinner"></span>
            <span>@Scan.FileOpVerb… @Scan.FileOpCurrent / @Scan.FileOpMax</span>
            <div class="progress-bar-track inline-bar">
                <div class="progress-bar-fill" style="width:@(Scan.FileOpMax > 0 ? 100 * Scan.FileOpCurrent / Scan.FileOpMax : 0)%"></div>
            </div>
        </div>
    }

    @* Move panel *@
    @if (_showMovePanel) {
        <div class="action-panel">
            <label>Destination folder:
                <input @bind="_moveDestination" placeholder="/path/to/destination" class="@(Directory.Exists(_moveDestination) ? "input-valid" : "")" />
            </label>
            <button class="primary" @onclick="MoveSelected" disabled="@(string.IsNullOrWhiteSpace(_moveDestination) || Scan.FileOpRunning)">Move @_selected.Count file(s)</button>
            <button @onclick="() => _showMovePanel = false">Cancel</button>
        </div>
    }

    @* Link panel *@
    @if (_showLinkPanel) {
        <div class="action-panel">
            <span>Replace each selected file with a link to the best remaining file of its group:</span>
            <label><input type="radio" name="linktype" checked="@(!_linkHard)" @onchange="() => _linkHard = false" /> Symlink</label>
            <label><input type="radio" name="linktype" checked="@_linkHard" @onchange="() => _linkHard = true" /> Hardlink (same volume only)</label>
            <button class="primary" @onclick="CreateLinksSelected" disabled="@Scan.FileOpRunning">Create links for @_selected.Count file(s)</button>
            <button @onclick="() => _showLinkPanel = false">Cancel</button>
        </div>
    }

    @* Delete confirmation *@
    @if (_confirmDelete || _confirmDeletePermanent) {
        bool perm = _confirmDeletePermanent;
        <div class="confirm-panel">
            <strong>&#x26A0; @(perm ? "Permanently delete" : "Move to trash")  @_selected.Count file(s)?</strong>
            @if (perm) { <span class="warn-text">This cannot be undone.</span> }
            <button class="danger" @onclick="() => ExecuteDelete(perm)">Confirm</button>
            <button @onclick="() => { _confirmDelete = false; _confirmDeletePermanent = false; }">Cancel</button>
        </div>
    }

    @* Operation result feedback *@
    @if (_operationMsg != null) {
        <div class="@(_operationFailed ? "error-box" : "info-box")">@_operationMsg</div>
    }

    @foreach (var group in pageGroups) {
        var groupId = group.GroupId;
        var sortedItems = SortItems(group.Items.ToList());
        bool allGroupSelected = sortedItems.All(i => _selected.Contains(i));
        bool isCollapsed = _collapsedGroups.Contains(groupId);
        float groupSimilarity = group.MinimumSimilarity;
        string groupSimilarityText = ResultPresentationUtils.FormatGroupSimilarity(sortedItems);
        int thumbnailCount = ThumbnailPositionResolver.GetFrameCount(sortedItems[0], Scan.Settings);
        int thumbnailIndex = Math.Clamp(_groupThumbnailIndices.GetValueOrDefault(groupId), 0, thumbnailCount - 1);
        long groupSize = group.TotalSize;
        int groupIndex = renderIndex++;
        int hiddenCount = sortedItems.Count(i => _hiddenItems.Contains(i.Path));
        var hoveredMetric = _hoveredMetrics.GetValueOrDefault(groupId);

        <div class="dup-group @(groupIndex == _focusedGroup ? "focused" : "")" @key="groupId">
            <div class="dup-group-header">
                <label class="group-select-all">
                    <input type="checkbox" checked="@allGroupSelected"
                           @onchange="() => ToggleGroup(sortedItems, !allGroupSelected)" />
                    @sortedItems.Count file(s) &#183; @FormatSize(groupSize)
                </label>
                <span class="similarity-badge @SimilarityClass(groupSimilarity)"
                      title="Range of member match scores; Reference items are excluded">
                    @groupSimilarityText
                </span>
                <div class="group-actions">
                    @if (thumbnailCount > 1) {
                        <button @onclick="() => ChangeGroupThumbnail(groupId, thumbnailCount, -1)"
                                title="Previous synchronized thumbnail">&#x276E;</button>
                        <span class="thumbnail-counter">@(thumbnailIndex + 1)/@thumbnailCount</span>
                        <button @onclick="() => ChangeGroupThumbnail(groupId, thumbnailCount, 1)"
                                title="Next synchronized thumbnail">&#x276F;</button>
                    }
                    <select class="group-sort" title="Sort cards"
                            @onchange="e => SetGroupSort(groupId, e.Value?.ToString())">
                        <option value="" selected="@(!_groupSorts.ContainsKey(groupId))">Sort by…</option>
                        <option value="similarity">Similarity</option>
                        <option value="size">Size</option>
                        <option value="duration">Duration</option>
                        <option value="bitrate">Bitrate</option>
                        <option value="resolution">Resolution</option>
                        <option value="date">Date</option>
                        <option value="name">Name</option>
                    </select>
                    <button class="compare-btn" @onclick="() => OpenCompare(sortedItems)" title="Compare fullsize">Compare</button>
                    <button @onclick="() => KeepBest(sortedItems)" title="Select all except best quality">Keep Best</button>
                    <button class="collapse-toggle" @onclick="() => ToggleCollapse(groupId)" title="@(isCollapsed ? "Expand" : "Collapse")">
                        @(isCollapsed ? "\u25B6" : "\u25BC")
                    </button>
                </div>
            </div>

            @if (!isCollapsed) {
                <div class="dup-cards">
                    @foreach (var item in sortedItems) {
                        if (_hiddenItems.Contains(item.Path)) continue;
                        bool sel = _selected.Contains(item);
                        bool isBest = item.IsBestBitRateKbs || item.IsBestFrameSize;
                        bool isSimilarityReference = ResultPresentationUtils.IsSimilarityReference(item, sortedItems);

                        <div class="dup-card @(isBest ? "best" : "") @(sel ? "selected" : "")"
                             @key="item.Path"
                             @onclick="() => ToggleItem(item)"
                             @oncontextmenu="e => ShowContextMenu(e, item, sortedItems)"
                             @oncontextmenu:preventDefault>

                            <div class="card-top-bar" @onclick:stopPropagation>
                                <label class="card-check">
                                    <input type="checkbox" checked="@sel" disabled="@IsProtected(item)"
                                           @onchange="() => ToggleItem(item)" />
                                    @if (IsProtected(item)) { <span class="protected-file-badge">Protected</span> }
                                </label>
                                <div style="display:flex;gap:0.2rem;">
                                    <button class="card-hide" @onclick="() => HideItem(item.Path)" title="Hide card">&#x1F441;</button>
                                    <button class="card-remove" @onclick="() => RemoveSingle(item)" title="Remove from list">&#x2715;</button>
                                </div>
                            </div>

                            <div class="card-thumb" @onclick:stopPropagation>
                                @if (WebSettings.AutoLoadThumbnails) {
                                    <div class="thumb-skeleton"></div>
                                    <img @key="(item.Path, thumbnailIndex)"
                                         data-src="@CardThumbUrl(item, thumbnailIndex)"
                                         alt="thumbnail"
                                         onerror="this.style.display='none'" />
                                }
                                else {
                                    <div class="thumb-placeholder">No preview</div>
                                }
                                <span class="similarity-overlay" title="@SimilarityTitle(item, isSimilarityReference)">
                                    @(isSimilarityReference ? "Reference" : $"{item.Similarity:F1}%")
                                </span>
                            </div>

                            <div class="card-body">
                                <div class="card-filename" title="@item.Path">@System.IO.Path.GetFileName(item.Path)</div>
                                <div class="card-path" title="@item.Path">@System.IO.Path.GetDirectoryName(item.Path)</div>

                                <div class="card-meta">
                                    @if (!item.IsImage) {
                                        <div class="meta-row" @onmouseover="() => SetHoveredMetric(groupId, MetricResolution)"
                                             @onmouseout="() => ClearHoveredMetric(groupId)">
                                            <span class="meta-label">Res</span>
                                            <span class="meta-value @MetaClass(item.IsBestFrameSize, hoveredMetric == MetricResolution && !item.IsBestFrameSize)">
                                                @if (hoveredMetric == MetricResolution && !item.IsBestFrameSize) {
                                                    @RelativeResolution(item, sortedItems)
                                                } else {
                                                    @(item.FrameSize ?? "?")
                                                }
                                            </span>
                                        </div>
                                        <div class="meta-row" @onmouseover="() => SetHoveredMetric(groupId, MetricDuration)"
                                             @onmouseout="() => ClearHoveredMetric(groupId)">
                                            <span class="meta-label">Dur</span>
                                            <span class="meta-value @MetaClass(item.IsBestDuration, hoveredMetric == MetricDuration && !item.IsBestDuration)">
                                                @if (hoveredMetric == MetricDuration && !item.IsBestDuration) {
                                                    @RelativeDuration(item, sortedItems)
                                                } else {
                                                    @item.Duration.ToString(@"hh\:mm\:ss")
                                                }
                                            </span>
                                        </div>
                                        <div class="meta-row" @onmouseover="() => SetHoveredMetric(groupId, MetricBitrate)"
                                             @onmouseout="() => ClearHoveredMetric(groupId)">
                                            <span class="meta-label">Bitrate</span>
                                            <span class="meta-value @MetaClass(item.IsBestBitRateKbs, hoveredMetric == MetricBitrate && !item.IsBestBitRateKbs)">
                                                @if (hoveredMetric == MetricBitrate && !item.IsBestBitRateKbs) {
                                                    @RelativePercentage(item.BitRateKbs, sortedItems.Where(i => i.IsBestBitRateKbs).Select(i => i.BitRateKbs).FirstOrDefault())
                                                } else {
                                                    @item.BitRateKbs<text> kbps</text>
                                                }
                                            </span>
                                        </div>
                                        <div class="meta-row" @onmouseover="() => SetHoveredMetric(groupId, MetricFps)"
                                             @onmouseout="() => ClearHoveredMetric(groupId)">
                                            <span class="meta-label">FPS</span>
                                            <span class="meta-value @MetaClass(item.IsBestFps, hoveredMetric == MetricFps && !item.IsBestFps)">
                                                @if (hoveredMetric == MetricFps && !item.IsBestFps) {
                                                    @RelativePercentageFloat(item.Fps, sortedItems.Where(i => i.IsBestFps).Select(i => i.Fps).FirstOrDefault())
                                                } else {
                                                    @item.Fps.ToString("F2")
                                                }
                                            </span>
                                        </div>
                                        <div class="meta-row">
                                            <span class="meta-label">Format</span>
                                            <span class="meta-value">@(item.Format ?? "?")</span>
                                        </div>
                                    }
                                    else {
                                        <div class="meta-row">
                                            <span class="meta-label">Res</span>
                                            <span class="meta-value @(item.IsBestFrameSize ? "meta-best" : "")">@(item.FrameSize ?? "?")</span>
                                        </div>
                                        <div class="meta-row">
                                            <span class="meta-label">Format</span>
                                            <span class="meta-value">@(item.Format ?? "?")</span>
                                        </div>
                                    }
                                    <div class="meta-row" @onmouseover="() => SetHoveredMetric(groupId, MetricSize)"
                                         @onmouseout="() => ClearHoveredMetric(groupId)">
                                        <span class="meta-label">Size</span>
                                        <span class="meta-value @MetaClass(item.IsBestSize, hoveredMetric == MetricSize && !item.IsBestSize)">
                                            @if (hoveredMetric == MetricSize && !item.IsBestSize) {
                                                @RelativePercentageLong(item.SizeLong, sortedItems.Where(i => i.IsBestSize).Select(i => i.SizeLong).FirstOrDefault())
                                            } else {
                                                @FormatSize(item.SizeLong)
                                            }
                                        </span>
                                    </div>
                                </div>

                                <div class="card-dates">
                                    <div title="Creation date recorded by the scan">Created: @FormatRuleDate(item.DateCreated)</div>
                                    <div title="Modification date recorded by the scan">Modified: @FormatRuleDate(item.DateModified)</div>
                                </div>

                                <div class="card-badges">
                                    @if (isBest) {
                                        <span class="badge-best">Best quality</span>
                                    }
                                    @if (item.Flags.HasFlag(VDF.Core.DuplicateFlags.PartialClip)) {
                                        <span class="badge-partial-clip">partial clip @item.PartialClipOffsetDisplay</span>
                                    }
                                    @if (item.Flags.HasFlag(VDF.Core.DuplicateFlags.AiMatched)) {
                                        <span class="badge-ai-matched">AI match</span>
                                    }
                                    @if (item.Flags.HasFlag(VDF.Core.DuplicateFlags.GrayscaleMatched)) {
                                        <span class="badge-partial-clip">grayscale</span>
                                    }
                                    @if (item.Flags.HasFlag(VDF.Core.DuplicateFlags.PHashMatched)) {
                                        <span class="badge-partial-clip">pHash</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @if (hiddenCount > 0) {
                        <div class="hidden-indicator" @onclick="() => ShowAllInGroup(sortedItems)">
                            +@hiddenCount hidden — click to show all
                        </div>
                    }
                </div>
            }
        </div>
    }

    <div class="results-pagination bottom" aria-label="Results pages">
        <span>Showing groups @firstVisibleGroup–@lastVisibleGroup</span>
        <button @onclick="() => GoToPage(1)" disabled="@(_currentPage <= 1)">First</button>
        <button @onclick="() => GoToPage(_currentPage - 1)" disabled="@(_currentPage <= 1)">Previous</button>
        <strong>Page @_currentPage / @pageCount</strong>
        <button @onclick="() => GoToPage(_currentPage + 1)" disabled="@(_currentPage >= pageCount)">Next</button>
        <button @onclick="() => GoToPage(pageCount)" disabled="@(_currentPage >= pageCount)">Last</button>
    </div>
}

@* Fullsize comparison modal *@
@if (_compareVisible && _compareItems != null && _compareItems.Count >= 2) {
    var itemA = _compareItems[_compareA];
    var itemB = _compareItems[_compareB];
    int frameCount = FramePositions.FrameCount(itemA, itemB, Scan.Settings);
    int frame = Math.Clamp(_compareFrame, 0, frameCount - 1);
    var frames = FramePositions.AlignedPair(itemA, itemB, frame, Scan.Settings);
    <div class="compare-overlay active" id="compare-modal" tabindex="0"
         @ref="_compareOverlay" @onkeydown="OnCompareKeyDown">
        <div class="compare-header">
            <h3>Compare</h3>
            <button class="compare-close" @onclick="CloseCompare" title="Close (Esc)" aria-label="Close">&#x2715;</button>
        </div>
        <div class="compare-mode-tabs">
            <button class="@(_compareMode == CompareMode.SideBySide ? "active" : "")" @onclick="() => SetCompareMode(CompareMode.SideBySide)">Side by Side</button>
            <button class="@(_compareMode == CompareMode.Swipe ? "active" : "")" @onclick="() => SetCompareMode(CompareMode.Swipe)">Swipe</button>
            @if (frameCount > 1) {
                @* The frames the scan sampled; a partial clip is lined up with its place in the source. *@
                <div class="compare-frames">
                    <button class="compare-frame-prev" disabled="@(frame == 0)"
                            @onclick="() => StepCompareFrame(-1)"
                            title="Previous frame (Left arrow)" aria-label="Previous frame">&#x25C0;</button>
                    <span class="compare-frame-count">Frame @(frame + 1) / @frameCount</span>
                    <button class="compare-frame-next" disabled="@(frame == frameCount - 1)"
                            @onclick="() => StepCompareFrame(1)"
                            title="Next frame (Right arrow)" aria-label="Next frame">&#x25B6;</button>
                </div>
            }
        </div>
        <div class="compare-selector">
            @for (int i = 0; i < _compareItems.Count; i++) {
                int idx = i;
                var ci = _compareItems[idx];
                string cls = idx == _compareA ? "active-a" : idx == _compareB ? "active-b" : "";
                <div class="compare-selector-item @cls"
                     @onclick="() => SelectCompareItem(idx)">
                    <img src="@CardThumbUrl(ci)" alt="" />
                    <div class="sel-label">@System.IO.Path.GetFileName(ci.Path)</div>
                </div>
            }
        </div>
        <div class="compare-body">
            @if (_compareMode == CompareMode.SideBySide) {
                <div class="compare-side-by-side">
                    <div class="compare-pane">
                        <div class="compare-pane-img">
                            <img src="@FullFrameUrl(itemA, frames.A)" alt="A" />
                        </div>
                        <div class="compare-pane-info">
                            <div class="compare-pane-label">@System.IO.Path.GetFileName(itemA.Path)</div>
                            <div class="compare-pane-meta">@if (!itemA.IsImage) {<span class="compare-frame-time">@FormatPosition(frames.A)</span><text> | </text>}@(itemA.FrameSize) | @FormatSize(itemA.SizeLong) | @itemA.BitRateKbs kbps</div>
                        </div>
                    </div>
                    <div class="compare-pane-divider"></div>
                    <div class="compare-pane">
                        <div class="compare-pane-img">
                            <img src="@FullFrameUrl(itemB, frames.B)" alt="B" />
                        </div>
                        <div class="compare-pane-info">
                            <div class="compare-pane-label">@System.IO.Path.GetFileName(itemB.Path)</div>
                            <div class="compare-pane-meta">@if (!itemB.IsImage) {<span class="compare-frame-time">@FormatPosition(frames.B)</span><text> | </text>}@(itemB.FrameSize) | @FormatSize(itemB.SizeLong) | @itemB.BitRateKbs kbps</div>
                        </div>
                    </div>
                </div>
            }
            else {
                <div class="compare-swipe" style="--swipe-pos: 50%">
                    <div class="compare-swipe-img-a">
                        <img src="@FullFrameUrl(itemA, frames.A)" alt="A" />
                    </div>
                    <div class="compare-swipe-img-b">
                        <img src="@FullFrameUrl(itemB, frames.B)" alt="B" />
                    </div>
                    <div class="compare-swipe-line"></div>
                    <div class="compare-swipe-handle">&#x2194;</div>
                    <span class="compare-swipe-label label-a">A@(itemA.IsImage ? "" : " " + FormatPosition(frames.A))</span>
                    <span class="compare-swipe-label label-b">B@(itemB.IsImage ? "" : " " + FormatPosition(frames.B))</span>
                </div>
            }
        </div>
    </div>
}

@* Context menu overlay + popup *@
@if (_menuVisible && _menuItem != null) {
    <div class="ctx-overlay" @onclick="HideContextMenu"></div>
    <div class="ctx-menu" style="left:@(_menuX.ToString("F0"))px;top:@(_menuY.ToString("F0"))px">
        <a class="ctx-menu-action"
           href="/media/open?path=@Uri.EscapeDataString(_menuItem.Path)"
           target="_blank"
           rel="noopener noreferrer"
           @onclick="HideContextMenu">Open file in browser</a>
        <button @onclick="() => ShowFolder(_menuItem)">Show this folder</button>
        <button @onclick="() => ExcludeFolder(_menuItem)">Exclude this folder</button>
        <button @onclick="() => CopyPath(_menuItem)">Copy path</button>
        <hr />
        <button @onclick="() => { ToggleItem(_menuItem); HideContextMenu(); }" disabled="@IsProtected(_menuItem)">
            @(_selected.Contains(_menuItem) ? "Deselect" : "Select")
        </button>
        @if (_menuGroup != null) {
            bool allSel = _menuGroup.All(i => _selected.Contains(i));
            <button @onclick="() => { ToggleGroup(_menuGroup, !allSel); HideContextMenu(); }">
                @(allSel ? "Deselect group" : "Select group")
            </button>
        }
        <hr />
        <button @onclick="() => { HideItem(_menuItem.Path); HideContextMenu(); }">Hide card</button>
        <button @onclick="() => RemoveSingle(_menuItem)">Remove from list</button>
    </div>
}

@code {
    string _search = string.Empty;
    IReadOnlyList<ResultGroupView> _allGroupViews = Array.Empty<ResultGroupView>();
    IReadOnlyList<ResultGroupView> _filteredGroupViews = Array.Empty<ResultGroupView>();
    long _groupViewRevision = -1;
    bool _filteredGroupsDirty = true;
    ResultSimilarityFilter _similarityFilter = ResultSimilarityFilter.All;
    ResultGroupSort _groupSort = ResultGroupSort.SimilarityDescending;
    int _pageSize = 50;
    int _currentPage = 1;
    bool _scrollToFirstGroupAfterRender;
    readonly HashSet<DuplicateItem> _selected = new();
    readonly HashSet<string> _excludedDirectories =
        new(VDF.Core.Utils.PathComparer.ForCurrentPlatform);
    bool _confirmDelete;
    bool _confirmDeletePermanent;
    bool _showMovePanel;
    bool _showLinkPanel;
    bool _linkHard;
    string _moveDestination = string.Empty;
    string? _operationMsg;
    bool _operationFailed;

    // Context menu
    bool _menuVisible;
    double _menuX, _menuY;
    DuplicateItem? _menuItem;
    List<DuplicateItem>? _menuGroup;

    // Auto-select dropdown
    bool _autoSelectOpen;
    bool _rulesOpen;
    string _protectedFolderInput = string.Empty;
    ResultSelectionRule _selectionRule = ResultSelectionRule.KeepProtectedFolders;
    AutoSelectScope _ruleScope = AutoSelectScope.AllFiltered;

    // QoL state
    readonly HashSet<Guid> _collapsedGroups = new();
    readonly HashSet<string> _hiddenItems = new();
    readonly Dictionary<Guid, string> _hoveredMetrics = new();
    readonly Dictionary<Guid, string> _groupSorts = new();
    readonly Dictionary<Guid, int> _groupThumbnailIndices = new();
    string? _folderFilter;
    int _focusedGroup = -1;

    // Comparison modal
    bool _compareVisible;
    List<DuplicateItem>? _compareItems;
    int _compareA;
    int _compareB = 1;
    CompareMode _compareMode = CompareMode.SideBySide;
    bool _compareSelectingB;
    int _compareFrame;
    ElementReference _compareOverlay;
    bool _focusCompare;

    enum CompareMode { SideBySide, Swipe }

    // Metric name constants (avoid escaped quotes in Razor attributes)
    const string MetricResolution = "resolution";
    const string MetricDuration = "duration";
    const string MetricBitrate = "bitrate";
    const string MetricFps = "fps";
    const string MetricSize = "size";

    enum AutoSelectMode { LowestQuality, SmallestFile, HundredPercentEqual }
    enum AutoSelectScope { CurrentPage, AllFiltered }

    protected override void OnInitialized() {
        Scan.StateChanged += OnStateChanged;
        SyncReviewStateFromService();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        try {
            if (firstRender && !_compareModeLoaded) {
                _compareModeLoaded = true;
                var saved = await JS.InvokeAsync<string>("vdf.getCompareMode");
                if (Enum.TryParse<CompareMode>(saved, out var parsed)) {
                    _compareMode = parsed;
                    StateHasChanged();
                }
            }
            await JS.InvokeVoidAsync("vdf.initLazyThumbs");
            if (_scrollToFirstGroupAfterRender) {
                _scrollToFirstGroupAfterRender = false;
                await JS.InvokeVoidAsync("vdf.scrollToGroup", 0);
            }
            if (_compareVisible && _focusCompare) {
                // The arrow keys and Esc are handled on the overlay, which only hears them with focus.
                _focusCompare = false;
                await _compareOverlay.FocusAsync();
            }
            if (_compareVisible && _compareMode == CompareMode.Swipe)
                await JS.InvokeVoidAsync("vdf.initSwipe");
        }
        catch { }
    }

    void OnStateChanged() {
        try { _ = InvokeAsync(StateHasChanged); }
        catch { }
    }

    void SyncReviewStateFromService(
        IReadOnlyCollection<DuplicateItem>? items = null) {
        items ??= Scan.Duplicates.ToList();
        _excludedDirectories.Clear();
        foreach (string directory in Scan.ExcludedResultDirectories)
            _excludedDirectories.Add(directory);

        var selectedPaths = new HashSet<string>(
            Scan.SelectedResultPaths,
            VDF.Core.Utils.PathComparer.ForCurrentPlatform);
        _selected.Clear();
        foreach (DuplicateItem item in items)
            if (selectedPaths.Contains(item.Path) && !IsProtected(item) &&
                !_excludedDirectories.Any(directory =>
                    ResultPresentationUtils.IsInDirectory(item.Path, directory)))
                _selected.Add(item);
        _filteredGroupsDirty = true;
    }

    void PersistReviewState() {
        _selected.RemoveWhere(IsProtected);
        Scan.UpdateResultReviewState(
            _selected.Select(item => item.Path),
            _excludedDirectories);
    }

    bool IsProtected(DuplicateItem item) => Scan.IsResultProtected(item.Path);

    static string FormatRuleDate(DateTime? date) => date is null || date == DateTime.MinValue
        ? "Unknown" : date.Value.ToString("yyyy-MM-dd HH:mm:ss") + (date.Value.Kind == DateTimeKind.Utc ? " UTC" : "");

    void AddProtectedFolder() {
        try {
            string directory = ResultSelectionRules.NormalizeDirectory(_protectedFolderInput);
            Scan.UpdateProtectedResultDirectories(Scan.ProtectedResultDirectories.Append(directory));
            _protectedFolderInput = string.Empty;
            _selected.RemoveWhere(IsProtected);
            _confirmDelete = _confirmDeletePermanent = false;
        }
        catch (Exception ex) { ShowMsg(ex.Message, true); }
    }

    void RemoveProtectedFolder(string directory) {
        try {
            Scan.UpdateProtectedResultDirectories(Scan.ProtectedResultDirectories.Where(path => path != directory));
            _confirmDelete = _confirmDeletePermanent = false;
        }
        catch (Exception ex) { ShowMsg(ex.Message, true); }
    }

    void ApplyRule(ResultSelectionRule rule, AutoSelectScope scope) {
        if (Scan.FileOpRunning) return;
        _autoSelectOpen = false;
        var scopedItems = GetSelectionScope(scope).SelectMany(group => group.Items).ToHashSet();
        var candidates = ResultSelectionRules.SelectForDeletion(
            Scan.Duplicates, scopedItems, Scan.ProtectedResultDirectories, rule);
        _selected.ExceptWith(scopedItems);
        _selected.UnionWith(candidates);
        _confirmDelete = _confirmDeletePermanent = false;
        PersistReviewState();
        ShowMsg($"Rule applied: {candidates.Count} file(s) selected for deletion in this scope. Review the selection, then use Delete.", false);
    }

    // === Selection ===
    void ToggleItem(DuplicateItem item) {
        if (IsProtected(item)) return;
        if (!_selected.Remove(item))
            _selected.Add(item);
        PersistReviewState();
    }

    void ToggleGroup(IEnumerable<DuplicateItem> items, bool select) {
        foreach (var item in items) {
            if (select) _selected.Add(item);
            else _selected.Remove(item);
        }
        PersistReviewState();
    }

    void InvertSelection(AutoSelectScope scope) {
        _autoSelectOpen = false;
        var scopedItems = GetSelectionScope(scope)
            .SelectMany(group => group.Items)
            .Distinct()
            .ToList();
        foreach (var item in scopedItems) {
            if (!_selected.Remove(item))
                _selected.Add(item);
        }
        PersistReviewState();
    }

    void ClearSelection() {
        _autoSelectOpen = false;
        _selected.Clear();
        PersistReviewState();
    }

    // === Remove / Delete / Move ===
    void RemoveSelected() {
        var selected = _selected.ToList();
        _selected.Clear();
        PersistReviewState();
        Scan.RemoveFromResults(selected);
        ShowMsg("Removed from results list.", false);
    }

    void RemoveSingle(DuplicateItem item) {
        HideContextMenu();
        Scan.RemoveFromResults(new List<DuplicateItem> { item });
        _selected.Remove(item);
        PersistReviewState();
    }

    async Task ExecuteDelete(bool permanent) {
        _confirmDelete = false;
        _confirmDeletePermanent = false;
        var toDelete = _selected.Where(item => !IsProtected(item)).ToList();
        var result = await Scan.DeleteItemsAsync(toDelete, permanent);
        _selected.RemoveWhere(item => !Scan.Duplicates.Contains(item));
        PersistReviewState();
        ShowOpResult($"{result.Done} file(s) {(permanent ? "permanently deleted" : "moved to trash")}", result);
    }

    async Task MoveSelected() {
        _showMovePanel = false;
        var toMove = _selected.ToList();
        var result = await Scan.MoveItemsAsync(toMove, _moveDestination);
        _selected.RemoveWhere(item => !Scan.Duplicates.Contains(item));
        PersistReviewState();
        ShowOpResult($"{result.Done} file(s) moved to '{_moveDestination}'", result);
    }

    async Task CreateLinksSelected() {
        _showLinkPanel = false;
        var toLink = _selected.ToList();
        var result = await Scan.CreateLinksAsync(toLink, _linkHard);
        _selected.RemoveWhere(item => !Scan.Duplicates.Contains(item));
        PersistReviewState();
        ShowOpResult($"{result.Done} file(s) replaced with {(_linkHard ? "hardlinks" : "symlinks")}", result);
    }

    void ShowOpResult(string action, FileOpResult result) {
        string msg = action;
        if (result.FreedBytes > 0) msg += $" — {FormatSize(result.FreedBytes)} freed";
        msg += ".";
        if (result.Failed > 0) msg += $" {result.Failed} failed: {string.Join("; ", result.Errors.Take(3))}";
        ShowMsg(msg, result.Failed > 0);
    }

    void ShowMsg(string msg, bool failed) {
        _operationMsg = msg;
        _operationFailed = failed;
        _ = Task.Delay(5000).ContinueWith(_ => InvokeAsync(() => {
            _operationMsg = null;
            StateHasChanged();
        }));
    }

    // === Context Menu ===
    void ShowContextMenu(MouseEventArgs e, DuplicateItem item, List<DuplicateItem> group) {
        _menuItem = item;
        _menuGroup = group;
        _menuX = e.ClientX;
        _menuY = e.ClientY;
        _menuVisible = true;
        _autoSelectOpen = false;
    }

    void HideContextMenu() {
        _menuVisible = false;
        _menuItem = null;
        _menuGroup = null;
    }

    void ShowFolder(DuplicateItem item) {
        HideContextMenu();
        try {
            var dir = Path.GetDirectoryName(item.Path);
            if (dir != null) {
                _folderFilter = Path.TrimEndingDirectorySeparator(Path.GetFullPath(dir));
                InvalidateFilteredGroups();
            }
        }
        catch (Exception ex) {
            ShowMsg($"Could not filter folder: {ex.Message}", true);
        }
    }

    void ClearFolderFilter() {
        _folderFilter = null;
        InvalidateFilteredGroups();
    }

    void ExcludeFolder(DuplicateItem item) {
        HideContextMenu();
        try {
            string? directory = Path.GetDirectoryName(item.Path);
            if (directory == null)
                return;
            string normalized = Path.TrimEndingDirectorySeparator(
                Path.GetFullPath(directory));
            if (_excludedDirectories.Add(normalized)) {
                _selected.RemoveWhere(selected =>
                    ResultPresentationUtils.IsInDirectory(
                        selected.Path,
                        normalized));
                InvalidateFilteredGroups();
                PersistReviewState();
            }
        }
        catch (Exception ex) {
            ShowMsg($"Could not exclude folder: {ex.Message}", true);
        }
    }

    void RemoveExcludedDirectory(string directory) {
        if (_excludedDirectories.Remove(directory)) {
            InvalidateFilteredGroups();
            PersistReviewState();
        }
    }

    void ClearExcludedDirectories() {
        if (_excludedDirectories.Count == 0)
            return;
        _excludedDirectories.Clear();
        InvalidateFilteredGroups();
        PersistReviewState();
    }

    async Task CopyPath(DuplicateItem item) {
        HideContextMenu();
        try { await JS.InvokeVoidAsync("vdf.copyToClipboard", item.Path); }
        catch { }
    }

    // === QoL: Collapse / Expand ===
    void ToggleCollapse(Guid groupId) {
        if (!_collapsedGroups.Remove(groupId))
            _collapsedGroups.Add(groupId);
    }

    void CollapseAll() {
        foreach (var g in Scan.Duplicates.Select(d => d.GroupId).Distinct())
            _collapsedGroups.Add(g);
    }

    void ExpandAll() => _collapsedGroups.Clear();

    // === QoL: Hide Cards ===
    void HideItem(string path) => _hiddenItems.Add(path);

    void ShowAllInGroup(List<DuplicateItem> items) {
        foreach (var item in items)
            _hiddenItems.Remove(item.Path);
    }

    // === QoL: Fullsize Compare ===
    bool _compareModeLoaded;
    void OpenCompare(List<DuplicateItem> items) {
        if (items.Count < 2) return;
        _compareItems = items;
        _compareA = 0;
        _compareB = Math.Min(1, items.Count - 1);
        _compareSelectingB = false;
        _compareFrame = FramePositions.MiddleFrame(CompareFrameCount());
        _compareVisible = true;
        _focusCompare = true;
    }

    int CompareFrameCount() =>
        _compareItems == null ? 1 : FramePositions.FrameCount(_compareItems[_compareA], _compareItems[_compareB], Scan.Settings);

    void StepCompareFrame(int delta) =>
        _compareFrame = Math.Clamp(_compareFrame + delta, 0, CompareFrameCount() - 1);

    void OnCompareKeyDown(KeyboardEventArgs e) {
        switch (e.Key) {
            case "ArrowLeft": StepCompareFrame(-1); break;
            case "ArrowRight": StepCompareFrame(1); break;
            case "Escape": CloseCompare(); break;
        }
    }

    // Built in code: Razor does not decode "&amp;" inside an attribute that mixes text and
    // expressions, so a URL written into the markup asked for "amp;w", "amp;q" and "amp;t",
    // which the server does not know, and got the defaults instead.
    string CardThumbUrl(DuplicateItem item, int? frameIndex = null) {
        TimeSpan position = frameIndex is int index &&
            ThumbnailPositionResolver.TryGetPosition(item, Scan.Settings, index, out TimeSpan requested)
                ? requested
                : FramePositions.DefaultTimestamp(item, Scan.Settings);
        return "/thumbnail/hq?path=" + Uri.EscapeDataString(item.Path) +
            "&w=" + WebSettings.ThumbnailWidth + "&q=" + WebSettings.ThumbnailJpegQuality +
            "&t=" + FramePositions.ToQueryValue(position);
    }

    static string FullFrameUrl(DuplicateItem item, TimeSpan at) =>
        "/thumbnail/full?path=" + Uri.EscapeDataString(item.Path) + "&t=" + FramePositions.ToQueryValue(at);

    static string FormatPosition(TimeSpan at) => at.ToString(@"hh\:mm\:ss");

    void SetCompareMode(CompareMode mode) {
        _compareMode = mode;
        _ = JS.InvokeVoidAsync("vdf.setCompareMode", mode.ToString());
    }

    void CloseCompare() => _compareVisible = false;

    async Task InitSwipeIfNeeded() {
        if (_compareMode == CompareMode.Swipe)
            await JS.InvokeVoidAsync("vdf.initSwipe");
    }

    void SelectCompareItem(int idx) {
        int framesBefore = CompareFrameCount();
        if (_compareSelectingB) {
            _compareB = idx;
        }
        else {
            _compareA = idx;
        }
        _compareSelectingB = !_compareSelectingB;
        // A partial clip steps through other frames than a plain duplicate: start over in the middle.
        int framesNow = CompareFrameCount();
        if (framesNow != framesBefore)
            _compareFrame = FramePositions.MiddleFrame(framesNow);
    }

    void ChangeGroupThumbnail(Guid groupId, int count, int delta) {
        if (count <= 1) return;
        int current = Math.Clamp(_groupThumbnailIndices.GetValueOrDefault(groupId), 0, count - 1);
        _groupThumbnailIndices[groupId] = (current + delta + count) % count;
    }

    static string SimilarityTitle(DuplicateItem item, bool isReference) {
        if (isReference)
            return "Reference source for this partial-clip group";
        if (!string.IsNullOrWhiteSpace(item.SimilarityReferencePath))
            return $"Compared with {Path.GetFileName(item.SimilarityReferencePath)}";
        return "Comparison reference unavailable (legacy result)";
    }

    // === QoL: Keep Best ===
    void KeepBest(List<DuplicateItem> items) {
        if (items.Count < 2) return;
        var keeper = PickHighestQuality(items);
        foreach (var item in items)
            if (item.Path != keeper.Path)
                _selected.Add(item);
        PersistReviewState();
    }

    // === QoL: Sort Within Group ===
    void SetGroupSort(Guid groupId, string? sort) {
        if (string.IsNullOrEmpty(sort))
            _groupSorts.Remove(groupId);
        else
            _groupSorts[groupId] = sort;
    }

    List<DuplicateItem> SortItems(List<DuplicateItem> items) {
        if (items.Count == 0) return items;
        var groupId = items[0].GroupId;
        if (!_groupSorts.TryGetValue(groupId, out var sort))
            return items.OrderByDescending(i => i.Similarity).ToList();

        return sort switch {
            "similarity" => items.OrderByDescending(i => i.Similarity).ToList(),
            "size" => items.OrderByDescending(i => i.SizeLong).ToList(),
            "duration" => items.OrderByDescending(i => i.Duration).ToList(),
            "bitrate" => items.OrderByDescending(i => i.BitRateKbs).ToList(),
            "resolution" => items.OrderByDescending(i => i.FrameSizeInt).ToList(),
            "date" => items.OrderByDescending(i => i.DateCreated).ToList(),
            "name" => items.OrderBy(i => System.IO.Path.GetFileName(i.Path)).ToList(),
            _ => items.OrderByDescending(i => i.Similarity).ToList()
        };
    }

    // === QoL: Hover-to-Compare ===
    void SetHoveredMetric(Guid groupId, string metric) => _hoveredMetrics[groupId] = metric;
    void ClearHoveredMetric(Guid groupId) => _hoveredMetrics.Remove(groupId);

    string RelativeDuration(DuplicateItem item, List<DuplicateItem> group) {
        var best = group.Where(i => i.IsBestDuration).Select(i => i.Duration).FirstOrDefault();
        if (best == TimeSpan.Zero) best = group.Max(i => i.Duration);
        var diff = item.Duration - best;
        if (Math.Abs(diff.TotalSeconds) < 1) return "=";
        string sign = diff < TimeSpan.Zero ? "-" : "+";
        var abs = diff < TimeSpan.Zero ? -diff : diff;
        if (abs.TotalHours >= 1) return $"{sign}{abs:h\\hm\\mss\\s}";
        if (abs.TotalMinutes >= 1) return $"{sign}{abs:m\\mss\\s}";
        return $"{sign}{abs.TotalSeconds:F0}s";
    }

    string RelativeResolution(DuplicateItem item, List<DuplicateItem> group) {
        int bestPixels = group.Where(i => i.IsBestFrameSize).Select(i => i.FrameSizeInt).FirstOrDefault();
        if (bestPixels == 0) bestPixels = group.Max(i => i.FrameSizeInt);
        if (bestPixels == 0) return "?";
        if (item.FrameSizeInt == bestPixels) return "=";
        double pct = (double)(item.FrameSizeInt - bestPixels) / bestPixels * 100;
        return $"{pct:+0;-0}%";
    }

    string RelativePercentage(decimal value, decimal best) {
        if (best == 0) return "?";
        if (value == best) return "=";
        double pct = (double)(value - best) / (double)best * 100;
        return $"{pct:+0;-0}%";
    }

    string RelativePercentageFloat(float value, float best) {
        if (best == 0) return "?";
        if (Math.Abs(value - best) < 0.01f) return "=";
        double pct = (value - best) / best * 100;
        return $"{pct:+0;-0}%";
    }

    string RelativePercentageLong(long value, long best) {
        if (best == 0) return "?";
        if (value == best) return "=";
        double pct = (double)(value - best) / best * 100;
        return $"{pct:+0;-0}%";
    }

    string MetaClass(bool isBest, bool showDelta) {
        if (isBest) return "meta-best";
        if (showDelta) return "meta-delta";
        return "";
    }

    static string SimilarityClass(float sim) => sim >= 99f ? "high" : sim >= 90f ? "medium" : "low";

    // === Filtering ===
    void EnsureGroupViewsCurrent() {
        long revision = Scan.ResultsRevision;
        if (_groupViewRevision == revision)
            return;

        var snapshot = Scan.Duplicates.ToList();
        _allGroupViews = ResultGroupProjection.Build(snapshot);
        _groupViewRevision = revision;
        _filteredGroupsDirty = true;
        SyncReviewStateFromService(snapshot);
    }

    IReadOnlyList<ResultGroupView> GetFilteredGroups() {
        EnsureGroupViewsCurrent();
        if (_filteredGroupsDirty) {
            _filteredGroupViews = ResultGroupProjection.FilterAndSort(
                _allGroupViews,
                _search,
                _folderFilter,
                _similarityFilter,
                _groupSort,
                _excludedDirectories);
            _currentPage = ResultGroupProjection.ClampPage(
                _currentPage, _filteredGroupViews.Count, _pageSize);
            _filteredGroupsDirty = false;
        }
        return _filteredGroupViews;
    }

    IReadOnlyList<ResultGroupView> GetCurrentPageGroups() {
        var groups = GetFilteredGroups();
        return ResultGroupProjection.GetPage(groups, _currentPage, _pageSize);
    }

    void InvalidateFilteredGroups(bool resetPage = true) {
        _filteredGroupsDirty = true;
        if (resetPage) {
            _currentPage = 1;
            _focusedGroup = 0;
        }
    }

    void OnSearchInput(ChangeEventArgs e) {
        _search = e.Value?.ToString() ?? string.Empty;
        InvalidateFilteredGroups();
    }

    void ClearSearch() {
        _search = string.Empty;
        InvalidateFilteredGroups();
    }

    void SetSimilarityFilter(ResultSimilarityFilter filter) {
        if (_similarityFilter == filter)
            return;
        _similarityFilter = filter;
        InvalidateFilteredGroups();
    }

    void OnGroupSortChanged(ChangeEventArgs e) {
        if (Enum.TryParse(e.Value?.ToString(), out ResultGroupSort sort)) {
            _groupSort = sort;
            InvalidateFilteredGroups();
        }
    }

    void OnPageSizeChanged(ChangeEventArgs e) {
        if (int.TryParse(e.Value?.ToString(), out int pageSize) &&
            pageSize is 25 or 50 or 100) {
            _pageSize = pageSize;
            InvalidateFilteredGroups();
        }
    }

    void GoToPage(int page) {
        var groups = GetFilteredGroups();
        int nextPage = ResultGroupProjection.ClampPage(page, groups.Count, _pageSize);
        if (_currentPage == nextPage)
            return;
        _currentPage = nextPage;
        _focusedGroup = 0;
        _scrollToFirstGroupAfterRender = true;
    }

    // === CSV Export ===
    async Task ExportCsv() {
        try { await JS.InvokeVoidAsync("vdf.download", "/export/csv"); }
        catch { }
    }

    // === QoL: Keyboard Navigation ===
    async Task OnKeyDown(KeyboardEventArgs e) {
        // Same group list the page renders, so j/k/x/1-9 act on what the user sees.
        var groups = GetCurrentPageGroups();
        if (groups.Count == 0) return;

        switch (e.Key) {
            case "j" or "J":
                _focusedGroup = Math.Min(_focusedGroup + 1, groups.Count - 1);
                await JS.InvokeVoidAsync("vdf.scrollToGroup", _focusedGroup);
                break;
            case "k" or "K":
                _focusedGroup = Math.Max(_focusedGroup - 1, 0);
                await JS.InvokeVoidAsync("vdf.scrollToGroup", _focusedGroup);
                break;
            case "x" or "X":
                if (_focusedGroup >= 0 && _focusedGroup < groups.Count) {
                    var items = groups[_focusedGroup].Items.ToList();
                    KeepBest(items);
                }
                break;
            case "h" or "H":
                // Hide/show card — would need card focus tracking, skip for now
                break;
            default:
                if (int.TryParse(e.Key, out int num) && num >= 1 && num <= 9) {
                    if (_focusedGroup >= 0 && _focusedGroup < groups.Count) {
                        var items = groups[_focusedGroup].Items.ToList();
                        if (num <= items.Count)
                            ToggleItem(items[num - 1]);
                    }
                }
                break;
        }
    }

    // === Auto-select ===
    IReadOnlyList<ResultGroupView> GetSelectionScope(AutoSelectScope scope) =>
        scope == AutoSelectScope.CurrentPage
            ? GetCurrentPageGroups()
            : GetFilteredGroups();

    void AutoSelect(AutoSelectMode mode, AutoSelectScope scope) {
        _autoSelectOpen = false;
        IReadOnlyList<ResultGroupView> scopedGroups = GetSelectionScope(scope);

        if (mode == AutoSelectMode.HundredPercentEqual) {
            foreach (ResultGroupView group in scopedGroups) {
                if (!group.IsDisplayedHundredPercent)
                    continue;
                DuplicateItem keeper = group.Items.FirstOrDefault(item =>
                    ResultPresentationUtils.IsSimilarityReference(item, group.Items))
                    ?? group.Items[0];
                foreach (DuplicateItem item in group.Items)
                    if (!ReferenceEquals(item, keeper))
                        _selected.Add(item);
            }
            PersistReviewState();
            return;
        }

        foreach (ResultGroupView group in scopedGroups) {
            var groupItems = group.Items.ToList();
            if (groupItems.Count < 2)
                continue;

            DuplicateItem keeper = mode switch {
                AutoSelectMode.LowestQuality => PickHighestQuality(groupItems),
                AutoSelectMode.SmallestFile  => groupItems.OrderByDescending(d => d.SizeLong).First(),
                _                            => groupItems[0]
            };

            foreach (var item in groupItems)
                if (item.Path != keeper.Path)
                    _selected.Add(item);
        }
        PersistReviewState();
    }

    static readonly VDF.Core.Utils.QualityRanker.Criterion<DuplicateItem>[] WebCriteria = {
        new("Duration",      d => d.Duration,        videoOnly: true),
        new("Resolution",    d => d.FrameSizeInt,    videoOnly: false),
        new("Bitrate",       d => d.BitRateKbs,      videoOnly: true),
        new("FPS",           d => d.Fps,             videoOnly: true),
        new("Audio Bitrate", d => d.AudioSampleRate, videoOnly: true),
        new("Size",          d => d.SizeLong,        videoOnly: false, ascending: true),
    };

    static DuplicateItem PickHighestQuality(List<DuplicateItem> items) =>
        VDF.Core.Utils.QualityRanker.PickKeeper(items, WebCriteria, d => d.IsImage);

    static string FormatSize(long bytes) {
        if (bytes < 0) return "?";
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024L * 1024 * 1024) return $"{bytes / (1024.0 * 1024):F1} MB";
        return $"{bytes / (1024.0 * 1024 * 1024):F2} GB";
    }

    public void Dispose() =>
        Scan.StateChanged -= OnStateChanged;
}
